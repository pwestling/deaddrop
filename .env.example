# Local development origin. Production: your stable HTTPS origin, without a path.
APP_URL=http://localhost:3000
# Generate once per instance: openssl rand -base64 32
# Keep this stable; changing it affects sessions and encrypted OAuth signing keys.
BETTER_AUTH_SECRET=
# Postgres URL, including SSL options from your provider.
# Use a pooled URL for the app; a direct URL for migrations/bootstrap.
DATABASE_URL=
# Choose r2 for Cloudflare R2 or vercel for Vercel Blob (default).
STORAGE_PROVIDER=vercel
# Required only for Vercel Blob, or temporarily as a migration read fallback.
BLOB_READ_WRITE_TOKEN=
# Required when STORAGE_PROVIDER=r2. Keep the bucket PRIVATE.
# Use Object Read & Write credentials restricted to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The only email allowed to administer this instance.
# Invited members can authorize connections within their assigned spaces.
OWNER_EMAIL=
# Optional display name, used only when creating the owner (default: Owner).
OWNER_NAME=
# At least 12 characters. Only used by owner:create; remove after initialization.
# Do not add OWNER_PASSWORD to the Vercel project environment.
OWNER_PASSWORD=
